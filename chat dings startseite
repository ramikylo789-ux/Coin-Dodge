if(ball.y+ball.s>=pad.y&&ball.x+ball.s>pad.x&&ball.x<pad.x+pad.w)ball.dy=-Math.abs(ball.dy);blocks.forEach((b,i)=>{if(hit(ball,b)){blocks.splice(i,1);ball.dy*=-1;score+=10}});if(ball.y>450)over=1;if(!blocks.length)over=2}
x.fillStyle="#fff";x.fillRect(pad.x,pad.y,pad.w,pad.h);x.fillRect(ball.x,ball.y,ball.s,ball.s);x.fillStyle="#5af";blocks.forEach(b=>x.fillRect(b.x,b.y,b.w,b.h));document.getElementById("i").textContent="Punkte: "+score;if(over){x.fillStyle="#000b";x.fillRect(0,0,600,450);x.fillStyle="#fff";x.textAlign="center";x.font="36px Arial";x.fillText(over===2?"GEWONNEN!":"GAME OVER",300,220);x.font="24px Arial";x.fillText("Punkte: "+score,300,260)}requestAnimationFrame(loop)}init();loop();
</script></body></html>"""
}


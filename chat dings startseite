const c=document.getElementById("c"),x=c.getContext("2d"),k={};let p,coin,e,lives,score,over;
onkeydown=a=>k[a.key.toLowerCase()]=1;onkeyup=a=>k[a.key.toLowerCase()]=0;
function rnd(s){return{x:Math.random()*(600-s),y:Math.random()*(400-s)}} function hit(a,b){return a.x<b.x+b.s&&a.x+a.s>b.x&&a.y<b.y+b.s&&a.y+a.s>b.y}
function init(){p={x:290,y:190,s:24,v:4};coin={...rnd(15),s:15};e=Array.from({length:3},()=>({...rnd(25),s:25,dx:Math.random()<.5?2:-2,dy:Math.random()<.5?2:-2}));lives=3;score=0;over=0}
function loop(){x.clearRect(0,0,600,400);if(!over){if(k.w||k.arrowup)p.y-=p.v;if(k.s||k.arrowdown)p.y+=p.v;if(k.a||k.arrowleft)p.x-=p.v;if(k.d||k.arrowright)p.x+=p.v;p.x=Math.max(0,Math.min(576,p.x));p.y=Math.max(0,Math.min(376,p.y));

<style>body{margin:0;background:#111;color:#fff;font-family:Arial;text-align:center}canvas{background:#222;border:2px solid #fff;max-width:95vw}button{padding:12px 20px;margin:10px;border:0;border-radius:10px;font-size:18px}</style></head>
<body><h1>🧱 Breakout</h1><div id="i">Punkte: 0</div><canvas id="c" width="600" height="450"></canvas><br><button onclick="location.href='../'">🏠 Startseite</button><button onclick="init()">🔄 Neustart</button>
<script>
const c=document.getElementById("c"),x=c.getContext("2d"),k={};let pad,ball,blocks,score,over;
onkeydown=e=>k[e.key.toLowerCase()]=1;onkeyup=e=>k[e.key.toLowerCase()]=0;
function init(){pad={x:250,y:420,w:100,h:12};ball={x:300,y:390,s:10,dx:3,dy:-3};blocks=[];score=0;over=0;for(let r=0;r<5;r++)for(let q=0;q<9;q++)blocks.push({x:20+q*63,y:30+r*25,w:55,h:16})}
function hit(a,b){return a.x<b.x+b.w&&a.x+a.s>b.x&&a.y<b.y+b.h&&a.y+a.s>b.y}

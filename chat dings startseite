with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for root, _, filenames in os.walk(base):
        for fn in filenames:
            fp = os.path.join(root, fn)
            z.write(fp, os.path.relpath(fp, base))

